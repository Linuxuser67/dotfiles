#!/bin/sh
set -eu

root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    printf '%s\n' 'guard-error: repository root unavailable' >&2
    exit 2
}
guard="$HOME/.local/bin/dots-upload-guard"
policy="$HOME/.config/dots-upload-guard/policy.json"
if [ ! -x "$guard" ]; then
    printf '%s\n' 'guard-error: immutable upload guard is unavailable' >&2
    exit 2
fi
if out=$(python3 "$guard" \
    --repo "$root" \
    --policy "$policy" \
    --staged 2>&1); then
    :
else
    status=$?
    printf '%s\n' "$out"
    exit "$status"
fi
